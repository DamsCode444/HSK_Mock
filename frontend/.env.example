VITE_API_BASE_URL=/api
VITE_BACKEND_TARGET=http://127.0.0.1:8000
# Set this only when frontend and API are on different origins in production.
VITE_MEDIA_ORIGIN=

# Public browser key only. Copy the publishable key from the Clerk dashboard.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Clerk, database, and B2 secrets belong only in backend/.env or your hosting
# provider's secret environment settings. Never put them in this frontend file.
